%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: Introduction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: Herd Mentality!
  Description: "Ma\xE9 ce reveille tout doucement de son sommeil..."
  m_nodes:
  - Name: Herd Mentality!
    Text: "Ugh... C'est d\xE9j\xE0 le matin ?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Plut\xF4t 13 h oui ! R\xE9veille-toi, feignasse."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Oh... T'es l\xE0, \xC9ric ! Comment \xE7a se fait que tu sois libre \xE0
      cette heure ? Ton boulot m\xE9diateur est fini?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Non pas dutout, c'est la magie de No\xEBl, Ma\xE9 ! Oh ! Oh ! Oh !"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Plus s\xE9rieusement, les groupes sont bizarrement plus calmes que d'habitude
      et je n'ai pas d\xFB g\xE9rer le d\xE9sordre qu'ils font d'habitude."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Tu trouves pas que c'est bizarre ? Il y a m\xEAme pas 2 jours, on aurait
      dit qu'ils allaient mettre le feu partout !"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Oui, c'est \xE9tonnant, mais ce qu'ils font dans leur temps libre ne me
      regarde pas, surtout quand j'en ai enfin pour moi."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Sinon, t'\xE9cris toujours dans le carnet que je t'ai donn\xE9 ?"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Oui, bien s\xFBr ! Je l'utilise tout le temps pour les paroles de mes
      musiques ou pour noter des choses que je pourrais oublier."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "\xC7a me fait vraiment plaisir, je savais que \xE7a aurait \xE9t\xE9 utile
      \xE0 une t\xEAte en l'air comme toi !"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: HEY ! C'EST PAS VRAI D'ABORD !
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Oulah, calmos le T-Rex. Bref, Ma\xE9, Lei voulait te parler d'urgence
      d'un truc important. La pauvre, elle avait l'air affol\xE9e."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: Ah bon ? Pourtant je ne pense pas qu'elle soit venue au QG, non ?
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Non, elle t'avais laiss\xE9 un message sur ta vieille station. Vas-y et
      va voir ce qu'elle te veut. Moi, je vais faire un somme."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Herd Mentality!
    Text: "Okay, repose-toi bien, \xC9ric. (\xC7a fait au moins 3 mois que je n'ai
      pas vue Lei, qu'est-ce qu'elle me veut du jour au lendemain ?)"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
