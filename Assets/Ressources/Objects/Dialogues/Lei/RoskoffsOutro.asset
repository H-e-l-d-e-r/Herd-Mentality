  m_nodes:
  - Name: Diffusion finale !
    Text: "Eh bien, je crois qu'on a un inspecteur de g\xE9nie avec nous !\n"
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: Diffusion finale !
    Text: Faudrait pas qu'on te laisse fouiller notre planque, ah ah !
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: Diffusion finale !
    Text: "S\xE9rieux, on n'aime pas les fouines ici, donc on ne veut pas n'importe
      qui... Il ne te reste plus qu'\xE0 diffuser tout \xE7a. ah ah ah ! "
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: Diffusion finale !
    Text: "C'est la derni\xE8re ligne droite, donne tout, Rockstar ! "
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
