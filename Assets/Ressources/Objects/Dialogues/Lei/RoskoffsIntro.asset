  m_nodes:
  - Name: 
    Text: "On est peut-\xEAtre des ROSKOFF, mais on est ON FIRE !\nBienvenue dans
      notre station d'enfer ! "
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Les \xE9nigmes et les m\xE9ninges, on n'aime pas \xE7a !\n"
