    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Mais bon, pour une vieille connaissance, on vous r\xE9serve plein de d\xE9fis
      bien d\xE9rang\xE9s. "
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Ne venez pas vous plaindre apr\xE8s !"
