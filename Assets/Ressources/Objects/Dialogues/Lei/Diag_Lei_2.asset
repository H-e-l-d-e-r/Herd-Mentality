  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: Diag_Lei_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: Lei
  Description: Le joueur passe vers la station 12700Hmz
  m_nodes:
  - Name: Lei
    Text: "Ceci est un message pr\xE9enregistr\xE9 :"
    Actor: {fileID: 11400000, guid: 7378c8590a27aef4782b1afed2dcc6c8, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Lei
    Text: "Salut ! Merci d'avoir r\xE9pondu \xE0 mon appel."
    Actor: {fileID: 11400000, guid: 7378c8590a27aef4782b1afed2dcc6c8, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Lei
    Text: "Cependant, avant de pouvoir collaborer, je dois m'assurer que l'un de
      vous sait utiliser une station de d\xE9cryptage."
    Actor: {fileID: 11400000, guid: 7378c8590a27aef4782b1afed2dcc6c8, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Lei
    Text: "En clair, ta station est form\xE9e de deux parties : la station de d\xE9cryptage
      et la radio, qui englobe le r\xE9glage de la fr\xE9quence et l'orientation
      de ton antenne."
    Actor: {fileID: 11400000, guid: 7378c8590a27aef4782b1afed2dcc6c8, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: Lei
    Text: "Vas-y, essaie d'orienter ton antenne vers 30\xB0. "
    Actor: {fileID: 11400000, guid: 7378c8590a27aef4782b1afed2dcc6c8, type: 2}
    ActorSprite: 0
    Behavior: 0
