  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J1_D4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J1_D4
  Description: "Efac, Ma\xE9 parlent dans le caf\xE9. Ma\xE9 est d\xE9prim\xE9e."
  m_nodes:
  - Name: J1_D4
    Text: "Ma\xE9 rentre dans le caf\xE9 et va saluer Efac. "
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D4
    Text: "Coucou Ma\xE9, qu\u2019est-ce que je peux faire pour toi ?\r\n"
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D4
    Text: "C\u2019est trop la gal\xE8re, R\xE9da et Eric m\u2019ont demand\xE9 de
      trouver des codes pour la radio et je n'y arrive pas trop\u2026\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D4
    Text: "Je peux s\xFBrement t\u2019aider ! J\u2019ai un scoop pour toi ! J\u2019ai
      entendu deux gars des Scylas qui se vantaient d\u2019avoir vandalis\xE9 un
      poste de police. "
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D4
    Text: "Il y a vraiment des Scylas qui passent ici ? Je pensais que le caf\xE9
      \xE9tait assez calme\u2026\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D4
    Text: "Eheh, j\u2019ai aussi r\xE9ussi \xE0 choper leur code de diffusion. Comme
      ils aiment bien qu\u2019on parle d\u2019eux, je suis certaine qu\u2019ils vont
      \xEAtre intrigu\xE9s et vous contacter !"
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D4
    Text: Oh merci ! Sinon tu penses je peux avoir un mocachino ?
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
