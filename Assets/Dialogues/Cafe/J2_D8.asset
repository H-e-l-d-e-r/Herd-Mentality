%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J2_D8
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J2_D8
  Description: "Efac, Ma\xE9, Otto\r\nCaf\xE9\r\n"
  m_nodes:
  - Name: J2_D8
    Text: "<i> Ma\xE9 entre dans le caf\xE9 <i>"
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Oh Ma\xE9 ? Salut !"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: Yo Otto,tu fais quoi ici tout seul ?
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Eric m\u2019avait donn\xE9 rendez-vous ici mais il \xE0 d\xE9cid\xE9 d\u2019ENCORE
      passer au magasin d'\xE9lectronique sans moi donc il est en retard."
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Cet hyperactif essaie toujours de faire 1000 choses \xE0 la fois, je peux
      te tenir compagnie ?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Avec plaisir, je commen\xE7ais \xE0 m\u2019ennuyer."
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Voici ton double-expresso Ott\u2026 Oh Salut Ma\xE9, je savais pas que
      c'\xE9tait toi qu\u2019Otto attendait "
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Non je suis de passage en attendant qu\u2019Eric se grouille.\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Non je suis de passage en attendant qu\u2019Eric se grouille.\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Ah okay comme d\u2019hab quoi. "
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Dis, j\u2019avais trouv\xE9 il y a un bout de temps un vinyle qui tra\xEEnait
      sur une table, vu que personne n\u2019est venu la chercher et je m'\xE9tais
      dit que ce style de musique te convenait bien."
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Trop bien ! C\u2019est quoi comme style ?\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Il me semble que c\u2019est de l\u2019acid, vraiment pas mon genre de
      musique. C\u2019est tout \xE0 toi !"
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Merci beaucoup Efac, on te fera une pub lors de la diffu\u2019 de ce soir."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: 'Et que je me retrouve encore avec un nouveau groupe dans les pattes ? '
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Non merci, les Jeunes Lettristes  sont encore facile \xE0 g\xE9rer, mais
      imagine si ceux du Squat Roskoff ou encore pire\u2026 la C.R.A.S.S.E adopte
      mon caf\xE9 comme refuge. \n"
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Ah ouais, j\u2019imagine que \xE7a deviendrait compliqu\xE9 \xE0 g\xE9rer\u2026
      En tout cas, merci encore pour le vinyle.\r\n"
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "D\xE9sol\xE9 pour l\u2019attente Otto ! <i> Dit Eric \xE0 bout de souffle
      <i>"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Pas de probl\xE8me il y avait Ma\xE9 et Efac pour me tenir compagnie"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Regarde Eric, le vinyle qu\u2019Efac ma pass\xE9, c\u2019est de l\u2019acid
      ! \r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: 'Trop cool, tu pourras le passer lors de la diffusion et en plus il pourra
      te servir pour communiquer.

'
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "N\u2019importe quel disque fonctionne en fait ?\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Exact, je vais pas rentrer dans les d\xE9tails mais chaque style \xE0
      sa signification m\xEAme que.."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 1
  - Name: J2_D8
    Text: 'Eric ? On avait pas un rendez-vous ?

'
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Ah oui d\xE9sol\xE9 Otto, Ma\xE9 on parlera de \xE7a plus tard okay ?\r\n"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D8
    Text: "Pas de soucis, on se voit tout \xE0 l\u2019heure !"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
