%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J2_D4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J2_D4
  Description: "Magasin de vinyle, Ma\xE9, Eric, Jeunes Lettristes."
  m_nodes:
  - Name: J2_D4
    Text: Bienvenue au magasin les jeunes ! Je peux vous aider ?
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Salut Val, on ne vient pas pour acheter, mais plut\xF4t pour voir s\u2019il
      s'\xE9tait pass\xE9 quelque chose d\u2019int\xE9ressant dans le coin ?"
    Actor: {fileID: 11400000, guid: 10b1b50698472d84e9132aad246c8589, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Eh, il est o\xF9 le vieux ? C\u2019est qui celle-l\xE0 ?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "C\u2019est la nouvelle propri\xE9taire du magasin, je t\u2019avais dit
      que l\u2019ancien avait pass\xE9 le flambeau \xE0 sa fille non ?\r\n"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Ah, Excuse-moi, je n\u2019ai m\xEAme pas pris la peine de me pr\xE9senter.
      Je suis Val, c\u2019est moi la nouvelle proprio du \u201CEast Jukeboxes\u201D."
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Ah d\u2019accord enchant\xE9, je savais pas que l\u2019Ancien allait prendre
      sa retraite, il disait toujours qu\u2019il mourait avec son magasin."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Ah d\u2019accord enchant\xE9, je savais pas que l\u2019Ancien allait prendre
      sa retraite, il disait toujours qu\u2019il mourait avec son magasin."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Oui\u2026 (Le visage de Val s'assombrit) \xC0 cause de ses probl\xE8mes
      de sant\xE9, il ne pouvait malheureusement plus tenir la cadence.\r\n"
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Oh non\u2026 c\u2019est si grave que ca? "
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Ne t\u2019inqui\xE8te pas les docteurs s\u2019occupent bien de lui, et
      vu son caract\xE8re il reprendra des forces tr\xE8s vite. "
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Maintenant revenons \xE0 vous, plut\xF4t j\u2019avais discut\xE9 avec
      des Jeunes Lettristes et il m\u2019ont parl\xE9 d\u2019un rassemblement qu\u2019ils
      organisaient dans les sous-sols de l\u2019universit\xE9 mais j\u2019ai pas
      capt\xE9 la date d\xE9sol\xE9."
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "C\u2019est d\xE9j\xE0 beaucoup Val ca nous aide \xE9norm\xE9ment."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Oh c\u2019est rien voyons, et je pense qu\u2019il doit y en avoir un qui
      est rest\xE9 pour s\u2019acheter un truc.\r\n"
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: " La derni\xE8re fois que je l\u2019ai vu, c'\xE9tait au fond du magasin
      pr\xE8s de la section Jazz."
    Actor: {fileID: 11400000, guid: 4b0b365ac0df3f840a918da53ce3bae3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D4
    Text: "Okay on va v\xE9rifier \xE7a avec lui encore merci Val, on se revoit bient\xF4t!"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
