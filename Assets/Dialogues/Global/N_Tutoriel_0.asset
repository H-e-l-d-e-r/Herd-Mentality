  Name: N_Tutoriel_0
  Description: 
  m_nodes:
  - Name: N_Tutoriel_0
    Text: "En radio, on proc\xE8de par trois phases."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_0
    Text: "D\xE9j\xE0, on met en place la station."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_0
    Text: "On d\xE9termine la fr\xE9quence de l\u2019\xE9metteur d\xE9cam\xE9trique
      ou la direction de l\u2019antenne biphas\xE9e. Puis, on s\u2019occupe de la
      diffusion pour enfin la cl\xF4turer."
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 1
    Behavior: 1
  - Name: N_Tutoriel_0
    Text: ...
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: N_Tutoriel_0
    Text: "Tu devrais r\xE9-expliquer point par point sinon tu risques de perdre
      Ma\xE9\u2026"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 1
    Behavior: 0
