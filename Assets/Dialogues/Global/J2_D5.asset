%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J2_D5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J2_D5
  Description: 
  m_nodes:
  - Name: J2_D5
    Text: "<i>Brouhaha incompr\xE9hensible devant un camion de pompier"
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: Vous allez nous le payer sale anarchistes !
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Viens prendre le reste de ta monnaie, c\u2019est pas \xE7a qui vas vous
      rendre vot\u2019 vieille station."
    Actor: {fileID: 11400000, guid: 1f461b77deff7aa48bf19ddba8a42a70, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Attends que je t\u2019attrape toi !"
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Hey, arr\xEAtez-\xE7a ! C\u2019est trop tard pour r\xE9cup\xE9rer ta station
      mec, ne risque pas de te faire embarquer.\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "On peut se battre et se faire emporter tous les deux ou t\u2019\xE9coute
      c\u2019que le petit gars dit, c\u2019est pas moi qui ait foutu le feu en plus.\r\n"
    Actor: {fileID: 11400000, guid: 1f461b77deff7aa48bf19ddba8a42a70, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "<b>MENTEUR!...ON VOUS A VU ENTRER DANS LE LOCAL\u2026 <b> Bordel, j\u2019avais
      toute ma vie l\xE0 dedans. "
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Vous vous prenez pour des h\xE9ros mais vous ne faites que d\xE9truire
      la vie des autres en pr\xF4nant une justice qui n\u2019arrange que vous !\n"
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "J'\xE9tais pas avec eux, l\xE2che moi ! J\u2019suis d\xE9sol\xE9 pour
      ta station, mais les flics vont pas me laisser tranquille s\u2019ils m\u2019attrapent,
      j'me tire ! \r\n"
    Actor: {fileID: 11400000, guid: 1f461b77deff7aa48bf19ddba8a42a70, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "T\u2019as pas int\xE9r\xEAt \xE0 balancer notre histoire ! "
    Actor: {fileID: 11400000, guid: 1f461b77deff7aa48bf19ddba8a42a70, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Hey, je sais que \xE7a va para\xEEtre un peu nul mais \xE7a va aller...
      Les pompiers essaient du mieux qu\u2019ils peuvent de sauver votre local."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Qu\u2019ils s\u2019essayent ou pas le r\xE9sultat est le m\xEAme, on \xE0
      perdu notre station et on n\u2019as pas l\u2019argent pour la retaper. C\u2019est
      fini. Laissez-moi tranquille avec vos excuses \xE0 2 balles."
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "D\xE9sol\xE9\u2026 "
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: " Viens Ma\xE9, il a besoin d'\xEAtre seul."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "C\u2019est quoi leurs probl\xE8mes \xE0 la C.R.A.S.S.E ? "
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D5
    Text: "Je sais qu\u2019ils sont violents d\u2019habitude mais la ca d\xE9passe
      les bornes, les pauvres ne les avaient rien fait \xE0 ce que je sache. C\u2019est
      trop bizarre."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
