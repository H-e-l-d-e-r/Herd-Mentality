  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: N_Tutoriel_4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: N_Tutoriel_4
  Description: Le resultat final
  m_nodes:
  - Name: N_Tutoriel_4
    Text: "Parfait, tout me semble bon pour commencer \xE0 diffuser !"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_4
    Text: "Tu peux diffuser de la musique gr\xE2ce \xE0 la platine, elle est reli\xE9e
      \xE0 l'\xE9metteur. "
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_4
    Text: "Ils sont dans le tiroir. N'h\xE9site pas \xE0 les \xE9couter avant de
      les jouer pour faire des bonnes transitions. Mets-en un sur le tourne-disque
      pour essayer !"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_4
    Text: "Essaie de faire attention au changement de musique, \xE9vite d'interrompre
      les sons et d'en r\xE9p\xE9ter : les gens n'aiment pas \xE7a\u2026"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_4
    Text: "Je crois que tu as toutes les bases, le reste tu le d\xE9couvriras en
      temps voulu. "
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_4
    Text: "Si tu as besoins n\u2019h\xE9site pas de nous demander de l\u2019aide
      !"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
