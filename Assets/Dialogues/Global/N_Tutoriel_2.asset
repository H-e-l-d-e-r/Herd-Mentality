  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: N_Tutoriel_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: N_Tutoriel_2
  Description: "Le modulateur de fr\xE9quence"
  m_nodes:
  - Name: N_Tutoriel_2
    Text: "Voici l\u2019\xE9metteur et le transformateur."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_2
    Text: "Pour le transformateur, d\xE8s que tu appuyeras sur le bouton <color=red>rouge</color>
      la diffusion commencera !"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_2
    Text: "Le gros bouton qui tourne permet de d\xE9finir sur quelle fr\xE9quence
      tu \xE9mets. Notre fr\xE9quence d\u2019\xE9mission est \xE9crite juste \xE0
      c\xF4t\xE9."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Tutoriel_2
    Text: "C\u2019est tellement long, comment je suis cens\xE9 retenir \xE7a ? Tu
      aurais d\xFB \xE9crire un manuel\u2026 "
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: N_Tutoriel_2
    Text: "J\u2019aurais eu beau faire un bouquin, tu n\u2019aurais pas r\xE9ussi
      \xE0 le lire."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
