%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: N_CRASSE_ENDING
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: N_CRASSE_ENDING
  Description: "La derni\xE8re partie."
  m_nodes:
  - Name: N_CRASSE_ENDING
    Text: "Ma\xE9 !"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Ma\xE9 ?"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Ma\xE9, r\xE9veille-toi !"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Il faudrait peut-\xEAtre l\u2019emmener \xE0 l\u2019h\xF4pital ?"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: Ouais, avec quelle thune on paie ?
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Tu pr\xE9f\xE8res laisser Ma\xE9 ?"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Elle rouvre les yeux ! J\u2019ai bien cru qu\u2019on allait te perde l\xE0\u2026"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Il s\u2019est pass\xE9 quoi ?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "La C.R.A.S.S.E est venue nous voler du mat\xE9riel."
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "on en a gard\xE9 une partie, mais ils ont r\xE9ussi \xE0 d\xE9truire le
      reste\u2026"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "C\u2019est quoi leur probl\xE8me \xE0 ces salauds\u202F? Ils n\u2019ont
      rien d\u2019autre \xE0 faire\u202F?"
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "<i>R\xE9da frappe dans un fly-case."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "En plus on ne peut m\xEAme plus retourner \xE0 la station puisqu\u2019ils
      savent qu\u2019on est planqu\xE9 l\xE0-bas ! On a plus d\u2019endroit o\xF9
      aller\u2026 \r\n"
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Ah ouais, maintenant \xE7a chouine hein\u202F?"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Tu fais le malin, tu fais le mec, tu n\u2019assumes rien depuis tout \xE0
      l\u2019heure et d\xE8s qu\u2019on doit assumer les cons\xE9quences, tu ne fais
      que de te plaindre\u202F?"
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: ' Otto, calme toi...'
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: " Depuis le d\xE9but, tu fais preuve de n\xE9gligence pour tout ! Voil\xE0
      o\xF9 on en est."
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: ...
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: ...
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: ...
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: ...
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "Bon. Vous savez quoi, c\u2019est chiant, mais je suis certain qu\u2019on
      va r\xE9ussir \xE0 rebondir."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "C\u2019est la faute de personne si des connards sont venus nous faire
      chier."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 1
    Behavior: 0
  - Name: N_CRASSE_ENDING
    Text: "\xC7a fait partie de notre histoire, et je dirais m\xEAme que c\u2019est
      le d\xE9but, de notre histoire."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 1
    Behavior: 0
