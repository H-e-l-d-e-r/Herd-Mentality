%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: N_Introduction
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: N_Introduction
  Description: 
  m_nodes:
  - Name: N_Introduction
    Text: "<i>Eric a les mains dans un \xE9metteur. Otto est \xE0 c\xF4t\xE9."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "C\u2019est pas possible, je comprends pas comment c\u2019est possible
      que le MOSFET ait cram\xE9 !"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "C\u2019est la troisi\xE8me fois que j'essaie de r\xE9parer l\u2019amplificateur\u202F!
      Otto, tu sais si on en a encore ?"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "Non, c'\xE9tait le dernier."
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "<i>R\xE9da, affal\xE9 sur le canap\xE9, les yeux rouges, se redresse."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "Mais gars, je sais pas pourquoi tu passes autant de temps \xE0 r\xE9parer
      les antennes..."
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 1
    Behavior: 0
  - Name: N_Introduction
    Text: "C\u2019est pas une antenne R\xE9da, c\u2019est un \xE9metteur, je pensais
      t\u2019avoir expliqu\xE9\u2026"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "\u201CC\u2019EsT pAs uNE AnTeNNE c\u2019eSt uN \xE9mETteur\u2026\""
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 1
    Behavior: 0
  - Name: N_Introduction
    Text: "Si tu arr\xEAtais de faire des blagues aussi nulles, tu nous serais plus
      utile..."
    Actor: {fileID: 11400000, guid: 66abae6a6093db84a9e9f714529bc892, type: 2}
    ActorSprite: 1
    Behavior: 0
  - Name: N_Introduction
    Text: "<i>R\xE9da s\u2019enfonce dans le fauteuil."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "J\u2019ai tellement h\xE2te de pouvoir faire notre premi\xE8re diffusion
      ! Vous imaginez, on sera au m\xEAme niveau que Ratz ou Diz, j\u2019ai tellement
      h\xE2te !"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 1
    Behavior: 0
  - Name: N_Introduction
    Text: "<i>Eric repose l\u2019\xE9metteur et le branche. Il se frotte les mains.
      Il se tourne vers R\xE9da."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "R\xE9da, plut\xF4t que de ricaner dans ton coin, tu peux aller mettre
      l\u2019antenne\u202F?"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "Ma\xE9, si tu veux Otto a trouv\xE9 une ancienne bo\xEEte de vinyles \xE0
      la brocante du quartier, tu peux aller la chercher\u202F? \r\n"
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "Tu peux pas la manquer, c\u2019est la seule sous l\u2019\xE9tabli, \xE0
      c\xF4t\xE9 d\u2019une flight case. "
    Actor: {fileID: 11400000, guid: d9b16eecb50285445b72b5a690b587a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: N_Introduction
    Text: "Attends, on va vraiment faire notre premi\xE8re diffusion ? \xE7a va \xEAtre
      trop bien !"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 1
    Behavior: 0
