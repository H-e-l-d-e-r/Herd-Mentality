  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: N_Exploration
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: N_Exploration
  Description: "Lorsque Ma\xE9 rentre dans le premier lieu, elle est interrompue
    par une personne myst\xE9rieuse.\r\n"
  m_nodes:
  - Name: 
    Text: "Votre \xE9mission d'hier. Elle \xE9tait bien."
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Merci ! Je fais de mon mieux. J'aime l'id\xE9e que n'importe qui puisse
      s'y retrouver."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 1
    Behavior: 0
  - Name: 
    Text: "N'importe qui ? Une fen\xEAtre ouverte sur tout laisse entrer le froid..."
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: Hein ?
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 2
    Behavior: 0
  - Name: 
    Text: "Plaire au plus grand nombre, c\u2019est prendre le risque de se perdre.
      East Heaven donne sur rien. C'est pour \xE7a qu'on passe devant sans s'arr\xEAter."
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Mais faites ce que vous voulez, parce qu\u2019au final cette radio ne
      reste que votre reflet. "
    Actor: {fileID: 11400000, guid: 9e35cff62f60c6f46a58392b393b651e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: <i> Il part.
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: Mais qui est ce type ?
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 2
    Behavior: 0
