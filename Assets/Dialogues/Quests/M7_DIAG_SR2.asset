--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: M7_DIAG_SR2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: M7_SR2
  Description: Voix de Ratz
  m_nodes:
  - Name: M7_SR2
    Text: "Coucou- Comment tu vas Ma\xE9 ?"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: "C\u2019est Ratz, depuis les Roskoff !"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: "C\u2019est Ratz, depuis les Roskoff ! Comment \xE7a fait d\u2019avoir
      un Roskoff en voix-\xE0-voix ?"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: "Je t\u2019appelais parce que j\u2019ai une demande assez particuli\xE8re\u2026"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: "En fait, depuis quelques temps, j\u2019ai des sentiments pour Rapido\u2026 "
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: " je sais que c\u2019est un gars bizarre, mais j\u2019ai toujours aim\xE9
      les gens marrants ! Mais j\u2019ai trop peur de lui dire en face\u2026"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: "Comme quoi m\xEAme ici on reste humain !"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: "Enfin bref, je voulais savoir si tu pouvais envoyer un message pour lui
      dire que je l\u2019aime\u2026"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M7_SR2
    Text: Fin de la communication.
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
