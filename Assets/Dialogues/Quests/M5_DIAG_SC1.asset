  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: M5_DIAG_SC1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: M5_SC1
  Description: "Voix radio d\u2019un Scilas"
  m_nodes:
  - Name: M5_SC1
    Text: "Bzzzzz\u2026 Transmission d\xE9marr\xE9e \xE0 07h11 depuis un lieu inconnu."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: M5_SC1
    Text: Yo les gars de Herd ! Tout plane pour vous ?
    Actor: {fileID: 11400000, guid: 1ea2bdb625fc2a749a012f5b6e8596d5, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M5_SC1
    Text: "Maintenant qu\u2019on a un peu fait nos affaires la derni\xE8re fois,
      on aimerait vous proposer un petit service."
    Actor: {fileID: 11400000, guid: 1ea2bdb625fc2a749a012f5b6e8596d5, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M5_SC1
    Text: "Dans quelques jours on change notre planque de place on cherche \xE0 garder
      \xE7a secret\u2026"
    Actor: {fileID: 11400000, guid: 1ea2bdb625fc2a749a012f5b6e8596d5, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M5_SC1
    Text: "Dans quelques jours on change notre planque de place on cherche \xE0 garder
      \xE7a secret\u2026 Tu comprends, on veut garder notre barbe \xE0 papa entre
      de bonnes mains\u2026 "
    Actor: {fileID: 11400000, guid: 1ea2bdb625fc2a749a012f5b6e8596d5, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M5_SC1
    Text: "Enfin voil\xE0, je t\u2019envoie les coordonn\xE9es apr\xE8s ce message.
      Vous savez ce qu\u2019il vous reste \xE0 faire ! "
    Actor: {fileID: 11400000, guid: 1ea2bdb625fc2a749a012f5b6e8596d5, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M5_SC1
    Text: Fin de transmission.
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
