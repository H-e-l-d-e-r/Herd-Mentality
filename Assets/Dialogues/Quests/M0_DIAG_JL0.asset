  Name: M0_JL0
  Description: "Voix radio d\u2019un jeune lettriste"
  m_nodes:
  - Name: 
    Text: "Biiiiip\u2026 Transmission d\xE9marr\xE9e \xE0 21h25 depuis l\u2019universit\xE9
      du Quartier Est."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: Salut la Herd Station ! Ici les Jeunes Lettristes !
    Actor: {fileID: 11400000, guid: 88440844a2f6e544482d8ea5152e5825, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Eric nous a parl\xE9 de votre station. On voulait vous faire part que
      nous sommes partant pour croiser nos chemins num\xE9riques."
    Actor: {fileID: 11400000, guid: 88440844a2f6e544482d8ea5152e5825, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "Eric nous a parl\xE9 de votre station. On voulait vous faire part que
      nous sommes partant pour croiser nos chemins num\xE9riques."
    Actor: {fileID: 11400000, guid: 88440844a2f6e544482d8ea5152e5825, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: 'Pour ce faire, on voudrait que vous fassiez une courte annonce pour notre
      dernier journal. '
    Actor: {fileID: 11400000, guid: 88440844a2f6e544482d8ea5152e5825, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: "On vous envoie les codes \xE0 2h00 sur notre canal."
    Actor: {fileID: 11400000, guid: 88440844a2f6e544482d8ea5152e5825, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: 
    Text: Fin de transmission.
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
