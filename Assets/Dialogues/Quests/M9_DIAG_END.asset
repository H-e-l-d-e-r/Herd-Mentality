  Name: M_9_End
  Description: La fin.
  m_nodes:
  - Name: M_9_End
    Text: "Le parlophone ne sonne pas. On dirait que vous avez aid\xE9 ceux qui en
      avaient besoins."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: M_9_End
    Text: "Mais il me semble qu'il vous reste encore des choses \xE0 faire. Des myst\xE8res
      \xE0 r\xE9soudre."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: M_9_End
    Text: La fin est proche mon ami.e.
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
