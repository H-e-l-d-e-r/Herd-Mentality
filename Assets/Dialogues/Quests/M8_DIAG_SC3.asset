  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: M8_DIAG_SC3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: M8_SC2
  Description: Voix de Diz
  m_nodes:
  - Name: M8_SC2
    Text: "Coucou Ma\xE9, c\u2019est encore Diz."
    Actor: {fileID: 11400000, guid: da259bd26b035c3dd87ad7e1eaa08d88, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M8_SC2
    Text: "Je voulais te dire que depuis le d\xE9but vous avez vraiment \xE9t\xE9
      des partenaires d\u2019exception."
    Actor: {fileID: 11400000, guid: da259bd26b035c3dd87ad7e1eaa08d88, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M8_SC2
    Text: "Gr\xE2ce \xE0 vous, nous avons pu vendre plus que d\u2019habitude et nous
      avons assez pour reprendre nos sc\xE9ances de m\xE9ditation astrales !"
    Actor: {fileID: 11400000, guid: da259bd26b035c3dd87ad7e1eaa08d88, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M8_SC2
    Text: "C\u2019est une super nouvelle pour le clan et nous vous redevons quelque
      chose !"
    Actor: {fileID: 11400000, guid: da259bd26b035c3dd87ad7e1eaa08d88, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M8_SC2
    Text: "N\u2019h\xE9sitez pas \xE0 passer si vous voulez partager une barbe \xE0
      papa ou souffler des bulles."
    Actor: {fileID: 11400000, guid: da259bd26b035c3dd87ad7e1eaa08d88, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: M8_SC2
    Text: Fin.
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
