%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J1_D3.0
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J1_D3.0
  Description: "Gege Way, Ma\xE9, dans la salle de concert"
  m_nodes:
  - Name: J1_D3.0
    Text: "<i>Ma\xE9 est dans la salle. Elle s\u2019approche de Gege."
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Je ne sais pas qui tu es, ni d'o\xF9 tu viens mais ici on ne m\u2019approche
      pas sans tr\xE8s bonne raison quand je suis occup\xE9."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Donc, pour lui manger une pizza quatre fromages, c'est \xCAtRe OcCuP\xE9
      ?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: Bon, tu veux quoi ?
    Actor: {fileID: 11400000, guid: bf86f15f8b2f11447a0bb1e5e0cebe8b, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Je cherche des informations sur les diff\xE9rents concerts organis\xE9s
      ici."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Tu n\u2019sais pas lire la pancarte\u202F? Je vais le faire pour toi alors
      : "
    Actor: {fileID: 11400000, guid: bf86f15f8b2f11447a0bb1e5e0cebe8b, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "\u201CLe prochain concert de la salle est Les Gorgonzolas ce samedi \xE0
      19h30\u201D."
    Actor: {fileID: 11400000, guid: bf86f15f8b2f11447a0bb1e5e0cebe8b, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Tu as bien \xE9cout\xE9\u202F? Je n\u2019r\xE9p\xE8te pas deux fois moi."
    Actor: {fileID: 11400000, guid: bf86f15f8b2f11447a0bb1e5e0cebe8b, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Bien re\xE7u ! Passez une bonne journ\xE9e G\xE9rard !"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J1_D3.0
    Text: "Si tu comptes en faire la promotion, je te conseille d\u2019en parler
      \xE0 Skunner avant, ceux qui l\u2019organisent.\r\n"
    Actor: {fileID: 11400000, guid: bf86f15f8b2f11447a0bb1e5e0cebe8b, type: 2}
    ActorSprite: 0
    Behavior: 0
