%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J2_D7
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J2_D7
  Description: "Ratz, Ma\xE9,Reda\r\nSalle de Concert\r\n"
  m_nodes:
  - Name: J2_D7
    Text: "Et c\u2019est l\xE0 qu'il \xE0 pris ma pochette et il s'est barr\xE9 avec
      mon fric."
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Mais nan gars, tu t\u2019es fait roul\xE9 !"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Crois moi que je vais le retrouver, dans tous les cas il \xE0 laiss\xE9
      son sac avec moi le d\xE9bile."
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: Ahahah, la loose.
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: Hey Reda je savais pas tu trainais ici.
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Yo Ma\xE9 ! bah ouais, la musique est chaude ici, on trouve tout ce qu\u2019on
      veut."
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: Sauf ton fric !
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "C\u2019est de l'histoire ancienne \xE7a, regardez ce que j\u2019ai trouv\xE9.\r\n"
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: <i>Reda montre un vinyle <i>
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: " T\u2019as trouv\xE9 \xE7a dans les affaires de ton racketteur ? C\u2019est
      un vinyle de quoi ?"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Je me suis pas fait racket\u2019... et c\u2019est de l\u2019hardcore gros.
      Ma\xE9 je le stockerai bien au local, tu peux me le chourrer quand t\u2019en
      as besoin."
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Ah vraiment ! Merci Reda ! Pour un mec qui vient de se faire voler t\u2019es
      vraiment g\xE9n\xE9reux."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Ma\xE9, me fait pas regretter\u2026"
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "Il pue le seum en v\xE9rit\xE9"
    Actor: {fileID: 11400000, guid: 5559205a7f6cd904ab929386e6539674, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D7
    Text: "J\u2019AI. PAS. LE. SEUM."
    Actor: {fileID: 11400000, guid: e6299d02b7ee1f24d9bb16266e7fcfc4, type: 2}
    ActorSprite: 0
    Behavior: 0
