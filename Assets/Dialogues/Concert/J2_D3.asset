%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J2_D3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J2_D3
  Description: 'Salle de concert, Squat Roskoff, Skunner

    

'
  m_nodes:
  - Name: J2_D3
    Text: "Ma\xE9 s\u2019approche du groupe\r\n"
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "Eh bah c\u2019est qu\u2019il y en a du bruit ici, vous faites quoi?"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "On pr\xE9pare le barbecue du squat ! Il est organis\xE9 tous les premiers
      samedi du mois.\r\n"
    Actor: {fileID: 11400000, guid: 9bfaa23eb41f1cd4f985bae74b3dd15d, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "Tu arrive \xE0 mettre le samedi sur un calendrier toi ?"
    Actor: {fileID: 11400000, guid: 8075864c9497893469aa9b7a02b155a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "J\u2019te rappelle que j'\xE9tais un jeune lettriste auparavant, ma gente
      dame."
    Actor: {fileID: 11400000, guid: 9bfaa23eb41f1cd4f985bae74b3dd15d, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "Bahahahah, m\u2019appelle pas comme \xE7a ducon. \r\n"
    Actor: {fileID: 11400000, guid: 8075864c9497893469aa9b7a02b155a3, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "Je vous prie, ma ch\xE8re, de pardonner mon impitoyable vocabulaire. Il
      m\u2019arrive trop trop souvent que le z\xE8le emporte ma langue, celle de
      Moli\xE8re."
    Actor: {fileID: 11400000, guid: 9bfaa23eb41f1cd4f985bae74b3dd15d, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "Et dans ces instants, o\xF9 mon bonheur \xE9touffe votre air, je prie
      pour que mon amiti\xE9 soit n\xE9cessaire afin de vous plaire. Sinon, oui,
      je sais quand c\u2019est samedi.  \r\n"
    Actor: {fileID: 11400000, guid: 9bfaa23eb41f1cd4f985bae74b3dd15d, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D3
    Text: "J'entends vos paroles et vous remercie de cette nouvelle stup\xE9fiante.
      Sur ce, je vous laisse Messieurs, Dames et Non-binaires."
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
