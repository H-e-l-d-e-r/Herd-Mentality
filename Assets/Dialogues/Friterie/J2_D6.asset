--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2167f615945d8c971b26f71484fb9f31, type: 3}
  m_Name: J2_D6
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueTable
  Name: J2_D6
  Description: "Bot Policier, Ma\xE9\r\nFriterie\r\n"
  m_nodes:
  - Name: J2_D6
    Text: "<i>Ma\xE9 entre dans la friterie <i>"
    Actor: {fileID: 0}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Hey, tu peux m\u2019accorder deux secondes j\u2019ai besoin d\u2019aide.\r\n"
    Actor: {fileID: 11400000, guid: 7253808c66d0ec740808a45d52c14da4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Oui bien s\xFBr, c\u2019est pour quoi ?\r\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Je suis dans une nouvelle agence de pub qui vient de s\u2019installer
      en ville et on m'a racont\xE9 qu\u2019ici le meilleur moyen de diffuser c'\xE9tait
      par radio ?"
    Actor: {fileID: 11400000, guid: 7253808c66d0ec740808a45d52c14da4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: " Oe c'est \xE7a, Dalheim est l\u2019endroit ou il y a le plus de stations
      ind\xE9pendantes malgr\xE9 l\u2019interdiction. Mais \xE7a, tu devrais le savoir
      pour une agence ? "
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Vous n\u2019avez pas fait de recherche sur la ville avant de vous installer
      ? C\u2019est quoi votre nom monsieur?\n"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Pas d\u2019importance, j\u2019aimerais juste savoir si t\u2019en fais
      ou si tu connais des potes qui en font ?\r\n"
    Actor: {fileID: 11400000, guid: 7253808c66d0ec740808a45d52c14da4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "C\u2019est interdit par ici, et m\xEAme si j\u2019en faisais je ne serai
      pas assez d\xE9bile pour le dire a n\u2019importe qui!\r\n"
    Actor: {fileID: 11400000, guid: 7253808c66d0ec740808a45d52c14da4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "T\u2019es prudente, j\u2019aime que mes collaborateurs soient prudents,
      tiens cette lettre tu ne risques pas de le regretter. "
    Actor: {fileID: 11400000, guid: 7253808c66d0ec740808a45d52c14da4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Pas besoin que je la lise pour toi, tu me semble tr\xE8s intelligente.
      Sur ce je vais te laisser. R\xE9fl\xE9chis-bien.\n"
    Actor: {fileID: 11400000, guid: 7253808c66d0ec740808a45d52c14da4, type: 2}
    ActorSprite: 0
    Behavior: 0
  - Name: J2_D6
    Text: "Okay\u2026 bonne journ\xE9e je suppose\u2026"
    Actor: {fileID: 11400000, guid: 30a2f09a16aaa7e47896431ec5d6b13e, type: 2}
    ActorSprite: 0
    Behavior: 0
